# Copy to .env.local for local development:
#
#   cp .env.example .env.local
#
# For production, set these in the Vercel dashboard:
#   Project → Settings → Environment Variables
#
# NOTE: every page is statically generated, so these are read at BUILD time.
# Changing a value on Vercel does nothing until you redeploy.

# Where buyer enquiries go. Rendered as the site's mailto link, and it is the
# only way a buyer can reach you — so the build fails if this is unset or still
# holds the placeholder below.
CONTACT_EMAIL=you@example.com

# Canonical origin, used for canonical tags, hreflang, the sitemap, robots.txt
# and structured data. No trailing slash. Optional — defaults to
# https://argonmodel.com, which is correct for production.
# SITE_URL=https://argonmodel.com
